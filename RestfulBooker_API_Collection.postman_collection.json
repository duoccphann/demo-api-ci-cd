        {
          "name": "R2 - Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// Kiểm tra tên khách hàng khớp với dữ liệu từ file CSV\r\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\r\n    var jsonData = pm.response.json();\r\n    var expectedFirstName = pm.iterationData.get(\"firstname\") || pm.variables.get(\"firstname\");\r\n    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r\n});\r\n\r\n// Lưu lại ID\r\nvar jsonData = pm.response.json();\r\npm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dữ liệu thay cho file booking_data.csv (gói Free không hỗ trợ data file trong Runner)\r\nconst rows = [\r\n    { firstname: \"Nguyen\", lastname: \"An\",   totalprice: 1500, depositpaid: true,  checkin: \"2026-11-01\", checkout: \"2026-11-05\", additionalneeds: \"Breakfast\" },\r\n    { firstname: \"Tran\",   lastname: \"Binh\", totalprice: 800,  depositpaid: false, checkin: \"2026-11-10\", checkout: \"2026-11-12\", additionalneeds: \"Extra Pillow\" },\r\n    { firstname: \"Le\",     lastname: \"Chi\",  totalprice: 2500, depositpaid: true,  checkin: \"2026-12-01\", checkout: \"2026-12-10\", additionalneeds: \"Late Checkout\" }\r\n];\r\n\r\n// pm.info.iteration bắt đầu từ 0: vòng 1 lấy dòng 0, vòng 2 lấy dòng 1...\r\nconst row = rows[pm.info.iteration % rows.length];\r\n\r\n// Đặt biến cục bộ để {{firstname}}, {{totalprice}}... trong body được thay giá trị\r\nObject.keys(row).forEach(key => pm.variables.set(key, String(row[key])));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"{{firstname}}\",\r\n    \"lastname\": \"{{lastname}}\",\r\n    \"totalprice\": {{totalprice}},\r\n    \"depositpaid\": {{depositpaid}},\r\n    \"bookingdates\": {\r\n        \"checkin\": \"{{checkin}}\",\r\n        \"checkout\": \"{{checkout}}\"\r\n    },\r\n    \"additionalneeds\": \"{{additionalneeds}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
